<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_P2P_ToBe" targetNamespace="https://github.com/chiamakaikpo">
  <bpmn:collaboration id="Collab_P2P_ToBe">
    <bpmn:participant id="Pool_P2P_ToBe" name="Procure-to-pay (to-be)" processRef="P2P_ToBe"/>
  </bpmn:collaboration>
  <bpmn:process id="P2P_ToBe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Requester">
        <bpmn:flowNodeRef>s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="P2P system">
        <bpmn:flowNodeRef>t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Budget holder">
        <bpmn:flowNodeRef>t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Procurement">
        <bpmn:flowNodeRef>t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Compliance">
        <bpmn:flowNodeRef>t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Finance (AP)">
        <bpmn:flowNodeRef>t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s" name="Need identified">
      <bpmn:outgoing>F_s_t1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="t1" name="Submit guided requisition (mandatory fields, budget code)">
      <bpmn:incoming>F_s_t1</bpmn:incoming>
      <bpmn:outgoing>F_t1_t2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t2" name="Validate fields and check budget">
      <bpmn:incoming>F_t1_t2</bpmn:incoming>
      <bpmn:outgoing>F_t2_g1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g1" name="Above approval threshold?">
      <bpmn:incoming>F_t2_g1</bpmn:incoming>
      <bpmn:outgoing>F_g1_t3</bpmn:outgoing>
      <bpmn:outgoing>F_g1_t4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t3" name="Approve or reject with budget shown">
      <bpmn:incoming>F_g1_t3</bpmn:incoming>
      <bpmn:outgoing>F_t3_t4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t4" name="Select supplier from approved list">
      <bpmn:incoming>F_g1_t4</bpmn:incoming>
      <bpmn:incoming>F_t3_t4</bpmn:incoming>
      <bpmn:outgoing>F_t4_g2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g2" name="Supplier verified?">
      <bpmn:incoming>F_t4_g2</bpmn:incoming>
      <bpmn:outgoing>F_g2_t6</bpmn:outgoing>
      <bpmn:outgoing>F_g2_t5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t5" name="Verify due diligence documents (KYC)">
      <bpmn:incoming>F_g2_t5</bpmn:incoming>
      <bpmn:outgoing>F_t5_t6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t6" name="Issue PO to supplier">
      <bpmn:incoming>F_g2_t6</bpmn:incoming>
      <bpmn:incoming>F_t5_t6</bpmn:incoming>
      <bpmn:outgoing>F_t6_t7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t7" name="Confirm goods receipt">
      <bpmn:incoming>F_t6_t7</bpmn:incoming>
      <bpmn:outgoing>F_t7_t8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t8" name="Three-way match PO, receipt, invoice">
      <bpmn:incoming>F_t7_t8</bpmn:incoming>
      <bpmn:outgoing>F_t8_g3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g3" name="Within tolerance?">
      <bpmn:incoming>F_t8_g3</bpmn:incoming>
      <bpmn:outgoing>F_g3_t10</bpmn:outgoing>
      <bpmn:outgoing>F_g3_t9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="t9" name="Resolve exception (reason shown)">
      <bpmn:incoming>F_g3_t9</bpmn:incoming>
      <bpmn:outgoing>F_t9_t10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="t10" name="Release payment">
      <bpmn:incoming>F_g3_t10</bpmn:incoming>
      <bpmn:incoming>F_t9_t10</bpmn:incoming>
      <bpmn:outgoing>F_t10_e</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e" name="Supplier paid">
      <bpmn:incoming>F_t10_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_s_t1" sourceRef="s" targetRef="t1"/>
    <bpmn:sequenceFlow id="F_t1_t2" sourceRef="t1" targetRef="t2"/>
    <bpmn:sequenceFlow id="F_t2_g1" sourceRef="t2" targetRef="g1"/>
    <bpmn:sequenceFlow id="F_g1_t3" name="Yes" sourceRef="g1" targetRef="t3"/>
    <bpmn:sequenceFlow id="F_g1_t4" name="No" sourceRef="g1" targetRef="t4"/>
    <bpmn:sequenceFlow id="F_t3_t4" name="Approved" sourceRef="t3" targetRef="t4"/>
    <bpmn:sequenceFlow id="F_t4_g2" sourceRef="t4" targetRef="g2"/>
    <bpmn:sequenceFlow id="F_g2_t6" name="Yes" sourceRef="g2" targetRef="t6"/>
    <bpmn:sequenceFlow id="F_g2_t5" name="No" sourceRef="g2" targetRef="t5"/>
    <bpmn:sequenceFlow id="F_t5_t6" sourceRef="t5" targetRef="t6"/>
    <bpmn:sequenceFlow id="F_t6_t7" sourceRef="t6" targetRef="t7"/>
    <bpmn:sequenceFlow id="F_t7_t8" sourceRef="t7" targetRef="t8"/>
    <bpmn:sequenceFlow id="F_t8_g3" sourceRef="t8" targetRef="g3"/>
    <bpmn:sequenceFlow id="F_g3_t10" name="Yes" sourceRef="g3" targetRef="t10"/>
    <bpmn:sequenceFlow id="F_g3_t9" name="No" sourceRef="g3" targetRef="t9"/>
    <bpmn:sequenceFlow id="F_t9_t10" sourceRef="t9" targetRef="t10"/>
    <bpmn:sequenceFlow id="F_t10_e" sourceRef="t10" targetRef="e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_P2P_ToBe">
    <bpmndi:BPMNPlane id="Plane_P2P_ToBe" bpmnElement="Collab_P2P_ToBe">
      <bpmndi:BPMNShape id="Pool_P2P_ToBe_di" bpmnElement="Pool_P2P_ToBe" isHorizontal="true"><dc:Bounds x="0" y="0" width="2174" height="780"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="34" y="0" width="2140" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="34" y="130" width="2140" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="34" y="260" width="2140" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="34" y="390" width="2140" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_4_di" bpmnElement="Lane_4" isHorizontal="true"><dc:Bounds x="34" y="520" width="2140" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_5_di" bpmnElement="Lane_5" isHorizontal="true"><dc:Bounds x="34" y="650" width="2140" height="130"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s"><dc:Bounds x="111" y="47" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t1_di" bpmnElement="t1"><dc:Bounds x="221" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t2_di" bpmnElement="t2"><dc:Bounds x="371" y="161" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g1_di" bpmnElement="g1" isMarkerVisible="true"><dc:Bounds x="554" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t3_di" bpmnElement="t3"><dc:Bounds x="671" y="291" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t4_di" bpmnElement="t4"><dc:Bounds x="821" y="421" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g2_di" bpmnElement="g2" isMarkerVisible="true"><dc:Bounds x="1004" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t5_di" bpmnElement="t5"><dc:Bounds x="1121" y="551" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t6_di" bpmnElement="t6"><dc:Bounds x="1271" y="161" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t7_di" bpmnElement="t7"><dc:Bounds x="1421" y="31" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t8_di" bpmnElement="t8"><dc:Bounds x="1571" y="161" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g3_di" bpmnElement="g3" isMarkerVisible="true"><dc:Bounds x="1754" y="170" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t9_di" bpmnElement="t9"><dc:Bounds x="1721" y="681" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t10_di" bpmnElement="t10"><dc:Bounds x="1871" y="681" width="116" height="68"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e"><dc:Bounds x="2061" y="697" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_s_t1_di" bpmnElement="F_s_t1"><di:waypoint x="147" y="65"/><di:waypoint x="221" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t1_t2_di" bpmnElement="F_t1_t2"><di:waypoint x="337" y="65"/><di:waypoint x="354" y="65"/><di:waypoint x="354" y="195"/><di:waypoint x="371" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t2_g1_di" bpmnElement="F_t2_g1"><di:waypoint x="487" y="195"/><di:waypoint x="554" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t3_di" bpmnElement="F_g1_t3"><di:waypoint x="604" y="195"/><di:waypoint x="638" y="195"/><di:waypoint x="638" y="325"/><di:waypoint x="671" y="325"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g1_t4_di" bpmnElement="F_g1_t4"><di:waypoint x="579" y="220"/><di:waypoint x="579" y="455"/><di:waypoint x="821" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t3_t4_di" bpmnElement="F_t3_t4"><di:waypoint x="787" y="325"/><di:waypoint x="804" y="325"/><di:waypoint x="804" y="455"/><di:waypoint x="821" y="455"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t4_g2_di" bpmnElement="F_t4_g2"><di:waypoint x="937" y="455"/><di:waypoint x="970" y="455"/><di:waypoint x="970" y="195"/><di:waypoint x="1004" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g2_t6_di" bpmnElement="F_g2_t6"><di:waypoint x="1054" y="195"/><di:waypoint x="1271" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g2_t5_di" bpmnElement="F_g2_t5"><di:waypoint x="1029" y="220"/><di:waypoint x="1029" y="585"/><di:waypoint x="1121" y="585"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t5_t6_di" bpmnElement="F_t5_t6"><di:waypoint x="1237" y="585"/><di:waypoint x="1254" y="585"/><di:waypoint x="1254" y="195"/><di:waypoint x="1271" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t6_t7_di" bpmnElement="F_t6_t7"><di:waypoint x="1387" y="195"/><di:waypoint x="1404" y="195"/><di:waypoint x="1404" y="65"/><di:waypoint x="1421" y="65"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t7_t8_di" bpmnElement="F_t7_t8"><di:waypoint x="1537" y="65"/><di:waypoint x="1554" y="65"/><di:waypoint x="1554" y="195"/><di:waypoint x="1571" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t8_g3_di" bpmnElement="F_t8_g3"><di:waypoint x="1687" y="195"/><di:waypoint x="1754" y="195"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g3_t10_di" bpmnElement="F_g3_t10"><di:waypoint x="1804" y="195"/><di:waypoint x="1929" y="195"/><di:waypoint x="1929" y="681"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_g3_t9_di" bpmnElement="F_g3_t9"><di:waypoint x="1779" y="220"/><di:waypoint x="1779" y="681"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t9_t10_di" bpmnElement="F_t9_t10"><di:waypoint x="1837" y="715"/><di:waypoint x="1871" y="715"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_t10_e_di" bpmnElement="F_t10_e"><di:waypoint x="1987" y="715"/><di:waypoint x="2061" y="715"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
